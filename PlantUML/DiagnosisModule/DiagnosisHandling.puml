' =========================
' Service
' =========================
    class DiagnosisService {
        +createManualDiagnosis(dto: CreateManualDiagnosisDTO): DiagnosisResponseDTO
        +createAutoDiagnosis(dto: CreateAutoDiagnosisDTO): DiagnosisResponseDTO
        +updateDiagnosis(id: Integer, dto: UpdateDiagnosisDTO): DiagnosisResponseDTO
        +deleteDiagnosis(id: Integer): void
        +confirmDiagnosis(id: Integer, engineerId: Integer): DiagnosisResponseDTO
        +rejectDiagnosis(id: Integer): DiagnosisResponseDTO
        +archiveDiagnosis(id: Integer): DiagnosisResponseDTO
        +getAllowedNextStatuses(diagnosisId: Integer): Set<DiagnosisStatus>
        +getDiagnosisEntity(id: Integer): Diagnosis
        +getDiagnosis(id: Integer): DiagnosisResponseDTO
        +getClaimDiagnoses(claimId: Integer): List<DiagnosisResponseDTO>
    }

    class DiagnosisPredictionService {
        +createManualPrediction(dto: CreateManualPredictionDTO): DiagnosisPredictionResponseDTO
        +generateAutoPrediction(diagnosisId: Integer): DiagnosisPrediction
        +updatePrediction(id: Integer, dto: UpdatePredictionDTO): DiagnosisPredictionResponseDTO
        +deletePrediction(id: Integer): void
        +getById(id: Integer): DiagnosisPredictionResponseDTO
        +getAllByDiagnosisId(diagnosisId: Integer): List<DiagnosisPredictionResponseDTO>
        +getDiagnosisPredictionEntity(id: Integer): DiagnosisPrediction
    }

    class PredictionAggregationService {
        +generatePredictionData(...): void
        +calculatePredictedTimeHours(...): void
        +calculatePredictedCost(...): void
        +calculateWarrantyProbability(...): void
        +calculateConfidenceScore(...): void
        +calculatePredictedComplexityLevel(...): void
        +recalculate(...): void
    }

    class EmbeddingService {
        +generateIfMissing(claim: Claim): void
        -generateEmbedding(claim: Claim): void
    }

    class SimilaritySearchService {
        +findSimilarClaims(claim: Claim): List<SimilarClaim>
        -vectorSearch(claim: Claim): List<SimilarClaim>
        -cosineSimilarity(a: float[], b: float[]): double
    }

    class PredictionStateService {
        +markAsHybridIfNeeded(prediction: DiagnosisPrediction): void
    }

    class PredictionExplanationService {
        +build(prediction: DiagnosisPrediction): PredictionContext
        +generateExplanation(context: PredictionContext): String
        -buildPrompt(context: PredictionContext): String
        -buildFallbackExplanation(context: PredictionContext): String
    }

    class DiagnosisStatusMachine {
        +allowsDiagnosisEdit(status: DiagnosisStatus): boolean
        +allowsDiagnosisDelete(status: DiagnosisStatus): boolean
        +allowsDiagnosisConfirm(status: DiagnosisStatus): boolean
        +allowsDiagnosisReject(status: DiagnosisStatus): boolean
        +allowsDiagnosisArchive(status: DiagnosisStatus): boolean
        +getAllowedNextStatuses(status: DiagnosisStatus): Set<DiagnosisStatus>
    }

' =========================
' Repository
' =========================
    interface DiagnosisRepository {
        +findById(id: Integer): Optional<Diagnosis>
        +findByClaimIdOrderByCreatedAtDesc(claimId: Integer): List<Diagnosis>
        +findFirstByClaimId(claimId: Integer): Optional<Diagnosis>
        +save(diagnosis: Diagnosis): Diagnosis
        +delete(diagnosis: Diagnosis): void
    }

    interface DiagnosisPredictionRepository {
        +findById(id: Integer): Optional<DiagnosisPrediction>
        +findByDiagnosisIdOrderByCreatedAtDesc(diagnosisId: Integer): List<DiagnosisPrediction>
        +existsByDiagnosisId(diagnosisId: Integer): boolean
        +save(prediction: DiagnosisPrediction): DiagnosisPrediction
        +delete(prediction: DiagnosisPrediction): void
    }

    interface ClaimRepository {
        +findById(id: Integer): Optional<Claim>
    }

    interface ClaimEmbeddingRepository {
        +existsById(claimId: Integer): boolean
        +findById(claimId: Integer): Optional<ClaimEmbedding>
        +findByClaimIdNot(claimId: Integer): List<ClaimEmbedding>
        +save(embedding: ClaimEmbedding): ClaimEmbedding
        +deleteById(claimId: Integer): void
    }

' =========================
' External clients
' =========================
package "External clients" {
    class GeminiEmbeddingClient {
        +embed(text: String): List<Double>
    }

    class GeminiLLMClient {
        +generate(prompt: String): String
    }
}

' =========================
' Entity classes
' =========================
    class Claim {
        -id: Integer
        -repairType: RepairType
        -status: ClaimStatus
        -defectDescription: String
        -equipment: Equipment
        -createdAt: LocalDateTime
    }

    class Equipment {
        -id: Integer
        -model: EquipmentModel
        -serialNumber: String
    }

    class EquipmentModel {
        -id: Integer
        -modelName: String
        -manufacturer: String
        -type: String
    }

    class Diagnosis {
        -id: Integer
        -claim: Claim
        -engineer: Employee
        -diagnosisType: DiagnosisType
        -preliminaryConclusion: String
        -finalConclusion: String
        -estimatedCost: BigDecimal
        -estimatedTimeHours: BigDecimal
        -status: DiagnosisStatus
        -confirmedAt: LocalDateTime
        -createdAt: LocalDateTime
        -updatedAt: LocalDateTime
    }

    class DiagnosisPrediction {
        -id: Integer
        -diagnosis: Diagnosis
        -predictedComplexityLevel: ComplexityLevel
        -predictionSource: PredictionSource
        -predictedCost: BigDecimal
        -predictedTimeHours: BigDecimal
        -predictionExplanation: String
        -predictedWarrantyProbability: BigDecimal
        -confidenceScore: BigDecimal
        -modelVersion: String
        -createdAt: LocalDateTime
        -updatedAt: LocalDateTime
    }

    class ClaimEmbedding {
        -claim: Claim
        -embedding_vector: byte[]
        -dimension: Integer
        -modelName: String
        -createdAt: LocalDateTime
    }

    class DiagnosisSimilarityResult {
        -id: Integer
        -prediction: DiagnosisPrediction
        -similarClaim: Claim
        -similarityScore: BigDecimal
        -rankPosition: Integer
    }

