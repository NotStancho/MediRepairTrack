@startuml
'https://plantuml.com/class-diagram

title Діаграма класів для реалізації функції інтелектуальної підтримки діагностування дефектів

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' =========================
' Controller
' =========================
    class DiagnosisController {
        +createManual(dto: CreateManualDiagnosisDTO): DiagnosisResponseDTO
        +createAuto(dto: CreateAutoDiagnosisDTO): DiagnosisResponseDTO
        +update(id: Integer, dto: UpdateDiagnosisDTO): DiagnosisResponseDTO
        +delete(id: Integer): void
        +confirm(id: Integer, engineerId: Integer): DiagnosisResponseDTO
        +reject(id: Integer): DiagnosisResponseDTO
        +archive(id: Integer): DiagnosisResponseDTO
        +getById(id: Integer): DiagnosisResponseDTO
        +getByClaim(claimId: Integer): List<DiagnosisResponseDTO>
        +getAllowedStatuses(id: Integer): Set<DiagnosisStatus>
    }

    class DiagnosisPredictionController {
        +createManual(dto: CreateManualPredictionDTO): DiagnosisPredictionResponseDTO
        +update(predictionId: Integer, dto: UpdatePredictionDTO): DiagnosisPredictionResponseDTO
        +delete(predictionId: Integer): void
        +recalculatePredictions(predictionId: Integer): void
        +getById(predictionId: Integer): DiagnosisPredictionResponseDTO
        +getAllByDiagnosisId(diagnosisId: Integer): List<DiagnosisPredictionResponseDTO>
    }


