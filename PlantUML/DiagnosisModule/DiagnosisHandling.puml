    class Employee {
        -id: Integer
        -position: String
        -specialization: String
    }

    class ComplexityLevel {
        -id: Integer
        -name: String
        -description: String
    }

    enum DiagnosisStatus {
        DRAFT
        PREDICTED
        CONFIRMED
        REJECTED
        ARCHIVED
    }

    enum DiagnosisType {
        MANUAL
        AUTOMATED
        HYBRID
    }

    enum PredictionSource {
        MANUAL
        AUTOMATED
        HYBRID
    }

    enum ClaimStatus {
        CREATED
        ACCEPTED
        IN_DIAGNOSIS
        IN_REPAIR
        COMPLETED
        REJECTED
    }

    enum RepairType {
        WAITING_DECISION
        WARRANTY_REPAIR
        POST_WARRANTY_REPAIR
    }

' =========================
' Controller dependencies
' =========================
DiagnosisController -> DiagnosisService
DiagnosisPredictionController --> DiagnosisPredictionService
DiagnosisPredictionController --> PredictionAggregationService

'DiagnosisController ..> CreateManualDiagnosisDTO
'DiagnosisController ..> CreateAutoDiagnosisDTO
'DiagnosisController ..> UpdateDiagnosisDTO
'DiagnosisController ..> DiagnosisResponseDTO
'
'DiagnosisPredictionController ..> CreateManualPredictionDTO
'DiagnosisPredictionController ..> UpdatePredictionDTO
'DiagnosisPredictionController ..> DiagnosisPredictionResponseDTO

' =========================
' Service dependencies
' =========================
DiagnosisService --> DiagnosisRepository
DiagnosisService --> DiagnosisPredictionRepository
DiagnosisService --> DiagnosisStatusMachine

DiagnosisPredictionService --> DiagnosisPredictionRepository
DiagnosisPredictionService --> DiagnosisService
DiagnosisPredictionService --> PredictionAggregationService
DiagnosisPredictionService --> PredictionStateService
DiagnosisPredictionService --> DiagnosisStatusMachine

PredictionAggregationService --> DiagnosisPredictionRepository
PredictionAggregationService --> PredictionExplanationService

EmbeddingService --> GeminiEmbeddingClient
EmbeddingService --> ClaimEmbeddingRepository
EmbeddingService --> ClaimRepository

SimilaritySearchService --> ClaimEmbeddingRepository

PredictionExplanationService --> GeminiLLMClient

' =========================
' Repository to Entity dependencies
' =========================
DiagnosisRepository ..> Diagnosis
DiagnosisPredictionRepository ..> DiagnosisPrediction
ClaimRepository ..> Claim
ClaimEmbeddingRepository ..> ClaimEmbedding

' =========================
' Entity relationships
' =========================
Equipment "1" --> "1" EquipmentModel
Claim "1" --> "1" Equipment
Claim "1" --> "0..*" Diagnosis
Claim "1" --> "0..1" ClaimEmbedding

Diagnosis "*" --> "0..1" Employee
Diagnosis "1" --> "0..*" DiagnosisPrediction

DiagnosisPrediction "*" --> "1" ComplexityLevel
DiagnosisPrediction "1" --> "0..*" DiagnosisSimilarityResult
'DiagnosisPrediction "1" --> "0..*" DiagnosisPredictionDefectCategory
'DiagnosisPrediction "1" --> "0..*" DiagnosisPredictionRepairWork

DiagnosisSimilarityResult "*" --> "1" Claim : similarClaim
'DiagnosisPredictionDefectCategory "*" --> "1" DefectCategory
'DiagnosisPredictionRepairWork "*" --> "1" RepairWork
'DiagnosisPredictionRepairWork "1" --> "0..*" DiagnosisPredictionRepairWorkPart
'DiagnosisPredictionRepairWorkPart "*" --> "1" Part

Claim --> ClaimStatus
Claim --> RepairType
Diagnosis --> DiagnosisStatus
Diagnosis --> DiagnosisType
DiagnosisPrediction --> PredictionSource

@enduml